# FaceForensics++ dataset
FACEFORENSICS_ROOT=E:\FaceForensics++

# Runtime directories
PREPARED_DATASET=datasets\prepared
WORKING_DATASET=datasets\working
RESULTS_DIR=results
MODELS_DIR=models
UPLOADS_DIR=uploads
TEMP_DIR=temp

# Training
BATCH_SIZE=16
NUM_WORKERS=0
LEARNING_RATE=0.001
EPOCHS=25
IMAGE_SIZE=224
EARLY_STOPPING_PATIENCE=5
SCHEDULER_PATIENCE=2

# Video processing
FRAME_INTERVAL=30

# Inference
CONFIDENCE_THRESHOLD=0.5

# Uploads
MAX_UPLOAD_SIZE_MB=500